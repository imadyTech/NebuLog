<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Keeps the public demo dashboard populated with realistic traffic. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>imady-nebulog-demo-producer</UserSecretsId>
    <ContainerRepository>imadytech/nebulog-demo-producer</ContainerRepository>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NebuLog.OpenTelemetry\NebuLog.OpenTelemetry.csproj" />
  </ItemGroup>
</Project>
