# Copy to /home/frank/imady.nebulog/.env on the deployment host, fill in real values, chmod 600.
# This file is an example only: never commit real values, and never print them.
#
# Every key here is referenced by name from compose.yaml, by the one service that needs it — there
# is no `env_file`, so no container receives a credential it has no use for. A missing key fails
# `docker compose up` with the message beside it rather than starting with an empty value.

# The immutable image tag to run. Produced by the release workflow as sha-<short commit>, or the
# bare version on a v* tag (for example 2.0.0). Never use `latest`.
NEBULOG_TAG=sha-xxxxxxx

# Seeded once, only if the account does not already exist. Password must be at least 12 characters.
NebuLog__Admin__Email=
NebuLog__Admin__Password=

# The demo producer's API key, in NebuLog's nbl_<prefix8>_<secret32> format. The server stores only
# its hash; generate one on the dashboard's API keys page, or let the server seed this value.
NebuLog__DemoProducer__ApiKey=

# The NebuShop demo services' API keys, same format as above. Generate the two separately — never
# reuse the demo producer's key — so either can be revoked on its own (ENV-REQ-002 reply §2.4).
NebuLog__ShopOrders__ApiKey=
NebuLog__ShopPayments__ApiKey=
