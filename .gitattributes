# Normalise line endings: LF in the repository, native on checkout.
* text=auto

# Windows-specific files keep CRLF
*.sln     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Shell scripts must stay LF
*.sh      text eol=lf

# Binary
*.png     binary
*.jpg     binary
*.ico     binary
*.vsdx    binary
*.woff2   binary
